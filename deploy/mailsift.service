# Persistent source deployment. Docker deployments use docker compose up -d.
#
# Install:
#   sudo cp deploy/mailsift.service /etc/systemd/system/mailsift.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now mailsift
# Logs: journalctl -u mailsift -f

[Unit]
Description=mailsift multi-account mail monitoring
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# WorkingDirectory determines the .env and data/ locations; change it to your path.
WorkingDirectory=/opt/mailsift
# Confirm the absolute node path with which node; nvm installs under ~/.nvm/versions/.
ExecStart=/usr/bin/node dist/src/main.js

# After SIGTERM the app finishes the current poll before exiting.
TimeoutStopSec=90
Restart=on-failure
RestartSec=10

# Run with a low-privilege user:
# useradd -r -s /usr/sbin/nologin mailwatch
# chown -R mailwatch:mailwatch /opt/mailsift
# User=mailwatch
# Group=mailwatch
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
