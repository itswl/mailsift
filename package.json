{
  "name": "mailsift",
  "version": "1.0.0",
  "description": "Multi-mailbox AI mail triage with its own web mail: watch inboxes and spam, judge what actually matters with an LLM, push only that, and read, file and answer it in the browser. MCP server included.",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --disable-warning=ExperimentalWarning dist/src/main.js",
    "dev": "tsx src/main.ts",
    "check": "tsx src/main.ts --check",
    "probe": "tsx scripts/probe.ts",
    "oauth": "tsx scripts/oauth-setup.ts",
    "mcp": "tsx src/mcp.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "mcp:prod": "node --disable-warning=ExperimentalWarning dist/src/mcp.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.300.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "imapflow": "^2.10.2",
    "mailparser": "^3.14.2",
    "nodemailer": "^10.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
