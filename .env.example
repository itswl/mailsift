# ============================================================================
# mailsift configuration. All settings live in this file.
# Copy it to .env and edit it: cp .env.example .env
# ============================================================================

# ---------------------------------------------------------------------------
# 1. Mail accounts (required; add any number, starting at 1)
#
#    Format: MAIL_ACCOUNT_N=provider|email|password[|custom-host]
#    The password is usually an app password or provider authorization code.
# ---------------------------------------------------------------------------

MAIL_ACCOUNT_1=qq|me@qq.com|app-password
MAIL_ACCOUNT_1_NAME=personal-qq
MAIL_ACCOUNT_1_FOLDERS=all

# Add another account from the same provider by incrementing the number.
# MAIL_ACCOUNT_2=qq|work@qq.com|another-app-password
# MAIL_ACCOUNT_2_NAME=work-qq

# For a provider not in the presets, use imap and specify its host.
# MAIL_ACCOUNT_3=imap|me@mycorp.com|password|imap.mycorp.com

# Gmail and Outlook generally require OAuth. Run npm run oauth once;
# no password is needed on these account lines afterward.
# MAIL_ACCOUNT_4=gmail|me@gmail.com
# MAIL_ACCOUNT_5=outlook|me@outlook.com

# Providers:
#   qq / qq_biz / 163 / 126 / sina / aliyun / feishu / lark
#   gmail / gmail_pw / outlook / icloud / fastmail / yahoo / zoho / yandex / gmx
#   imap (specify a host; any IMAP provider can be used)
#
# Optional per-account settings (replace N with the account number):
#   MAIL_ACCOUNT_N_NAME     Display name in notifications; defaults to provider-user.
#   MAIL_ACCOUNT_N_FOLDERS  Folders to monitor; default: INBOX,spam.
#                           all  = all folders except sent, drafts, and trash (recommended).
#                           spam = automatically detect the provider's spam folder.
#   MAIL_ACCOUNT_N_PORT     Default: 993.
#   MAIL_ACCOUNT_N_SSL      Default: true.
#   MAIL_ACCOUNT_N_AUTH     Follows the provider preset by default.

# ---------------------------------------------------------------------------
# 2. Notification outputs (configure at least one; both can be enabled)
# ---------------------------------------------------------------------------

# Feishu / Lark custom bot
FEISHU_WEBHOOK_URL=
# Required only when signature verification is enabled on the bot.
FEISHU_WEBHOOK_SECRET=

# Generic webhook output (WEBHOOKWISE_* names are kept for compatibility)
WEBHOOKWISE_URL=
WEBHOOKWISE_TOKEN=
WEBHOOKWISE_SOURCE=mailsift

# ---------------------------------------------------------------------------
# 3. LLM (optional; without it, local keyword fallback is used)
#
#    mailsift sends OpenAI-compatible POST requests to /chat/completions.
#    The response must contain choices[0].message.content with JSON in this form:
#    {"results":[{"index":0,"importance":"info|warning|critical",...
#    }]} (see src/services/triage.ts for the complete contract).
# ---------------------------------------------------------------------------

# Option 1: use a provider preset.
#   Options: dashscope / deepseek / glm / minimax / moonshot / openai /
#        openrouter / siliconflow / xai / zhipu
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
LLM_API_KEY=

# Option 2: use a custom or self-hosted OpenAI-compatible endpoint.
# Leave LLM_PROVIDER empty when LLM_BASE_URL is set.
# LLM_PROVIDER=
# LLM_BASE_URL=https://your-gateway.example.com/v1
# LLM_MODEL=gpt-5.6-luna

# Messages per LLM batch. Larger batches cost less but increase failure impact.
LLM_BATCH_SIZE=10
# Number of body characters sent per email. Larger values cost more.
LLM_BODY_CHARS=1200
LLM_TIMEOUT_SECONDS=60
# Set false if the provider does not support response_format=json_object.
# mailsift retries without response_format when the provider explicitly rejects it.
LLM_JSON_MODE=true
# Language of summaries, reasons, and categories: en (default), zh-CN, zh-TW,
# auto (follow each message's language), or any language name. Categories use
# the same language, so auto can split digest groups across languages.
LLM_OUTPUT_LANGUAGE=en
# Verification codes and one-time passwords stay on the local classifier by default.
LLM_SKIP_SENSITIVE=true
# Redact email addresses, phone numbers, payment card numbers, and resident ID
# numbers before sending fields to the LLM. Card and ID numbers are redacted only
# when their checksum holds, so order, waybill, and invoice numbers stay readable.
# Local notifications retain the original values.
LLM_REDACT_PII=true
# Alert after this many consecutive LLM failures; triage continues with fallback.
LLM_ALERT_AFTER_FAILURES=2

# If the request fails, the response is invalid, or its indices are duplicated or
# out of range, the whole batch uses the local keyword fallback (a misaligned
# index list cannot be trusted for any message). A message merely omitted from an
# otherwise valid response falls back on its own. Keyword hits remain
# warning-level alerts; other messages become info and are queued for
# digest/review. Recovery does not automatically re-triage messages that were
# already processed during fallback.

# ---------------------------------------------------------------------------
# 4. Classification and notification rules
# ---------------------------------------------------------------------------

# Most important: tell the model who you are and what matters to you.
# Specific context produces better triage results.
#
# Keep this on one line. Unquoted newlines in .env truncate the value.
MAIL_CONTEXT=I am a software engineer. Do not push routine low-value bank alerts; push unusual transactions, security events, deadlines, interviews, contracts, and messages that explicitly ask me to act.

# Sender rules (comma-separated). Three forms:
#   @bank.com          the address domain or any subdomain (not the display name)
#   alerts@bank.com    exactly that address
#   newsletter         a substring of the address or display name
# Matches are marked critical without consulting the LLM.
MAIL_ALWAYS_IMPORTANT=
# Same forms; matches are marked info without consulting the LLM.
MAIL_NEVER_IMPORTANT=
# Fallback keywords used when the LLM is unavailable (comma-separated).
MAIL_KEYWORDS=verification code,bill,past due,frozen,unusual login,contract,interview,invoice

# Minimum importance for real-time push: info / warning / critical.
# Use critical to reduce notifications; lower levels remain in the digest.
PUSH_MIN_IMPORTANCE=warning

# Importance bonus for spam-folder mail (0-2).
# Set 1 if missing a spam misclassification is more costly than an extra alert.
# The bonus applies to every delivery decision, including FEISHU_MIN_IMPORTANCE,
# so raising it does send more spam-folder mail to the notification channel.
SPAM_RANK_BONUS=0

# ---------------------------------------------------------------------------
# 5. Daily digest: collect messages below the push threshold.
# ---------------------------------------------------------------------------

DIGEST_ENABLED=true
DIGEST_HOUR=9
DIGEST_MIN_IMPORTANCE=info

# ---------------------------------------------------------------------------
# 6. Runtime settings (usually no changes needed)
# ---------------------------------------------------------------------------

# Poll interval in seconds.
POLL_INTERVAL_SECONDS=300
# Lookback window for the first scan.
INITIAL_LOOKBACK_DAYS=3
# Bound each fresh-lookback backfill chunk without skipping the remaining backlog.
MAX_MESSAGES_PER_LOOKBACK=500
# Per-folder message limit per poll.
MAX_MESSAGES_PER_POLL=200
# Do not download/parse messages larger than this many bytes. Skipped messages
# remain visible through the MCP dead-letter query instead of disappearing.
MAX_MESSAGE_SOURCE_BYTES=5242880
# Total message limit across all accounts and folders per poll.
MAX_MESSAGES_PER_POLL_TOTAL=500
# Maximum concurrent account connections.
MAX_CONCURRENT_ACCOUNTS=5
# Immediate retries (2s, then 5s apart) for a notification push that fails with a
# network error, a timeout, or HTTP 408/429/5xx, before the outbox retries it on
# the next poll. Other rejections are not retried. Set 1 to disable.
SINK_RETRY_ATTEMPTS=3

# Real-time wake-ups over IMAP IDLE (RFC 2177). One read-only connection per
# account and folder stays open; a new-mail notification fetches that folder at
# once on the same connection. Polling keeps running as the reconciliation pass,
# so raise POLL_INTERVAL_SECONDS to 900-1800 when this is on. Accounts whose
# server does not advertise IDLE (see npm run probe) stay on polling. Folders
# listed here must also be monitored; "all" is not accepted.
IMAP_IDLE_ENABLED=false
IMAP_IDLE_FOLDERS=INBOX

STATE_DB_PATH=data/mailsift.db
STATE_RETENTION_DAYS=90
TOKEN_STORE_PATH=data/tokens.json

LOG_LEVEL=info
# Set true to log notifications without sending them.
DRY_RUN=false

# Optional OpenTelemetry metrics. Leave OTEL_METRICS_EXPORTER unset for local no-op mode.
# Set OTEL_EXPORTER_OTLP_ENDPOINT to the Collector base URL, for example http://otel-collector:4318.
# Do not put mailbox addresses, Message-IDs, or subjects in metric attributes.
# OTEL_METRICS_EXPORTER=otlp_proto
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_METRIC_EXPORT_INTERVAL_MS=60000

# Keep verification codes and one-time passwords out of the LLM entirely.
LLM_SKIP_SENSITIVE=true
# Redact direct identifiers in fields sent to the LLM; local notifications keep original content.
LLM_REDACT_PII=true

# Alert after consecutive failures to avoid noise from transient network/OAuth errors.
# This applies to authentication failures too: a single Outlook IMAP "Login failed"
# can be a temporary OAuth/token hiccup and should not create an alert/recovery pair.
ACCOUNT_ALERT_AFTER_FAILURES=2
ACCOUNT_ALERT_COOLDOWN_SECONDS=21600
LLM_ALERT_AFTER_FAILURES=2

# ---------------------------------------------------------------------------
# 7. OAuth (only needed for Gmail / Outlook)
#
#    Register an application in Google Cloud Console / Azure to obtain credentials.
#    Use credentials from a trusted source only.
# ---------------------------------------------------------------------------

# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# OUTLOOK_CLIENT_ID=
# OUTLOOK_CLIENT_SECRET=
# OUTLOOK_TENANT=consumers

# ---------------------------------------------------------------------------
# 8. Embedded remote MCP mode (enabled by default)
#
#    With MCP_ENABLED=true, Streamable HTTP is exposed at /mcp in the main process.
#    MCP_BIND is the address inside the container/process. MCP_PUBLIC_HOST is the
#    Docker host address; the Compose mapping uses MCP_PORT on both sides.
#    Keep MCP_PUBLIC_HOST on 127.0.0.1 unless a reverse proxy or tunnel needs it.
#    A non-loopback MCP_BIND requires MCP_TOKEN. Without a token, loopback is
#    intentionally unauthenticated because it is not exposed beyond the host.
# ---------------------------------------------------------------------------

# MCP_ENABLED=true
# MCP_PUBLIC_HOST=127.0.0.1  Host-side Docker publish address; not used by npm run dev.
# MCP_BIND=0.0.0.0          Container/process listen address for Docker forwarding.
# MCP_PORT=8410              Host and container port in docker-compose.yml.
# MCP_TOKEN=
# MCP_RATE_LIMIT_PER_MINUTE=120
# MCP_LIVE_BODY_CHARS=20000       Max normalized body characters returned by live IMAP.
# MCP_LIVE_SOURCE_BYTES=5242880   Max raw message bytes inspected by live IMAP.
# MCP_LIVE_LOOKBACK_DAYS=90       Bounded fallback search window by Message-ID.
# MCP_LIVE_SEARCH_MAX_MESSAGES=500 Maximum candidates in that fallback search.
# MCP_TRANSPORT=stdio             Set to http only when running src/mcp.ts standalone.

# OAuth callback listener port; register http://localhost:<port>/ with the provider.
# OAUTH_REDIRECT_PORT=8765
# Optional minimum level for Feishu output: info / warning / critical.
# FEISHU_MIN_IMPORTANCE=warning

# Pin the Docker image to a released version instead of mutable latest.
# MAILSIFT_VERSION=1.0.0
