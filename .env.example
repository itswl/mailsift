# ============================================================================
# mailsift 配置 —— 全部配置都在这个文件里，没有第二个配置文件
# 复制为 .env 后修改：cp .env.example .env
# ============================================================================

# ---------------------------------------------------------------------------
# 1. 邮箱账号（必填，可配任意多个，序号从 1 往下加）
#
#    格式：MAIL_ACCOUNT_N=provider|邮箱地址|密码[|自定义host]
#    这里的"密码"几乎都不是登录密码，而是各家的「授权码 / 应用专用密码」。
# ---------------------------------------------------------------------------

MAIL_ACCOUNT_1=qq|me@qq.com|授权码
MAIL_ACCOUNT_1_NAME=QQ主号
MAIL_ACCOUNT_1_FOLDERS=all

# 同一家配多个账号，序号往下加就行
# MAIL_ACCOUNT_2=qq|work@qq.com|另一个授权码
# MAIL_ACCOUNT_2_NAME=QQ工作号

# 不在预设表里的邮箱：用 imap 并写上自己的 host
# MAIL_ACCOUNT_3=imap|me@mycorp.com|密码|imap.mycorp.com

# Gmail / Outlook 关掉了密码登录，必须先跑一次 npm run oauth 授权，
# 授权后这一行不需要填密码
# MAIL_ACCOUNT_4=gmail|me@gmail.com
# MAIL_ACCOUNT_5=outlook|me@outlook.com

# 可选 provider：
#   国内  qq / qq_biz / 163 / 126 / sina / aliyun / feishu / lark
#   国外  gmail / gmail_pw / outlook / icloud / fastmail / yahoo / zoho / yandex / gmx
#   通用  imap（自己写 host，任何支持 IMAP 的邮箱都能接）
#
# 每个账号可选的额外配置（把 N 换成账号序号）：
#   MAIL_ACCOUNT_N_NAME     推送里显示的名字，默认 provider-用户名
#   MAIL_ACCOUNT_N_FOLDERS  监控哪些文件夹，默认 INBOX,spam
#                           all  = 除已发送/草稿/废纸篓外的所有文件夹（推荐，归档邮件也不漏）
#                           spam = 自动识别垃圾箱，各家叫法不同不用管
#   MAIL_ACCOUNT_N_PORT     默认 993
#   MAIL_ACCOUNT_N_SSL      默认 true
#   MAIL_ACCOUNT_N_AUTH     默认跟随 provider，一般不用改

# ---------------------------------------------------------------------------
# 2. 推送出口（至少配一个，两个可以同时配）
# ---------------------------------------------------------------------------

# 飞书 / Lark 自定义机器人
FEISHU_WEBHOOK_URL=
# 机器人开了签名校验才需要填
FEISHU_WEBHOOK_SECRET=

# WebhookWise（或任何接收 JSON 的 HTTP 端点）
WEBHOOKWISE_URL=
WEBHOOKWISE_TOKEN=
WEBHOOKWISE_SOURCE=mailsift

# ---------------------------------------------------------------------------
# 3. 大模型（不配也能跑，但只能走关键词兜底，判得很粗，强烈建议配）
#
#    任何兼容 OpenAI /chat/completions 的服务都能接。
# ---------------------------------------------------------------------------

# 方式一：用预设厂商，只写名字不用记地址
#   可选 dashscope / deepseek / glm / minimax / moonshot / openai /
#        openrouter / siliconflow / xai / zhipu
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
LLM_API_KEY=

# 方式二：接预设之外的服务（含自建中转）——留空 LLM_PROVIDER，直接写地址
# LLM_PROVIDER=
# LLM_BASE_URL=https://your-gateway.example.com/v1
# LLM_MODEL=gpt-5.6-luna

# 建议给这把 key 单独设一个每日额度上限，跑飞了也有兜底

# 每批送几封给模型判断。调大省钱，但单批失败影响面更大
LLM_BATCH_SIZE=10
# 每封邮件正文截取多少字送给模型。够用即可，调大直接涨钱
LLM_BODY_CHARS=1200
LLM_TIMEOUT_SECONDS=60
# 模型不支持 response_format=json_object 时改成 false
LLM_JSON_MODE=true

# ---------------------------------------------------------------------------
# 4. 判什么、推什么
# ---------------------------------------------------------------------------

# 【最重要的一项】告诉模型你是谁、什么对你算要紧事。
# 写得越具体，判得越准。这是把它从"通用分类器"变成"你的助理"的关键。
#
# 必须写成一行。.env 里不加引号的换行会被静默截断成第一行，后面的规则会无声丢失。
MAIL_CONTEXT=我是一名软件工程师，工作和生活都在这几个邮箱上。银行的日常小额消费提醒不用实时推送，只有单笔超过 200 元或出现异常/盗刷/风控才要立刻知道。GitHub 上只是抄送我的 PR 讨论和日常 CI 失败不用推，@我、指派给我、请我 review、安全公告才推。验证码、账单到期、快递异常、面试与合同要重点关注。

# 发件人或关键词命中就直接判 critical，不经过模型（逗号分隔）
MAIL_ALWAYS_IMPORTANT=
# 命中就直接判 info（逗号分隔），适合屏蔽已知噪音
MAIL_NEVER_IMPORTANT=
# 模型不可用时的兜底关键词（逗号分隔）
MAIL_KEYWORDS=验证码,账单,逾期,冻结,异常登录,合同,面试,发票

# 达到哪一级才实时推送：info / warning / critical
# 嫌吵就调成 critical，剩下的都留到每日简报里看
PUSH_MIN_IMPORTANCE=warning

# 垃圾箱里的邮件提升几档重要性（0-2）。
# 垃圾箱误判的代价比误推高，怕漏就设 1
SPAM_RANK_BONUS=0

# ---------------------------------------------------------------------------
# 5. 每日简报：把没到推送门槛的邮件攒起来，每天固定时间发一条
# ---------------------------------------------------------------------------

DIGEST_ENABLED=true
DIGEST_HOUR=9
DIGEST_MIN_IMPORTANCE=info

# ---------------------------------------------------------------------------
# 6. 运行参数（一般不用改）
# ---------------------------------------------------------------------------

# 多久扫一次（秒）
POLL_INTERVAL_SECONDS=300
# 首次运行往回看几天，避免第一次跑就把历史邮件全推一遍
INITIAL_LOOKBACK_DAYS=3
# 同时连几个邮箱
MAX_CONCURRENT_ACCOUNTS=5

STATE_DB_PATH=data/mailsift.db
STATE_RETENTION_DAYS=90
TOKEN_STORE_PATH=data/tokens.json

LOG_LEVEL=info
# 设为 true 则只打印不真发，用来试配置
DRY_RUN=false

# 连续几次失败后发告警，避免网络抖一下就吵
ACCOUNT_ALERT_AFTER_FAILURES=2
ACCOUNT_ALERT_COOLDOWN_SECONDS=21600
LLM_ALERT_AFTER_FAILURES=2

# ---------------------------------------------------------------------------
# 7. OAuth（只有用 Gmail / Outlook 才需要）
#
#    可以到 Google Cloud Console / Azure 门户注册自己的应用拿凭据；
#    不想注册的话，公开渠道也能搜索到现成可用的公开凭据，填法相同。
# ---------------------------------------------------------------------------

# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# OUTLOOK_CLIENT_ID=
# OUTLOOK_CLIENT_SECRET=
# OUTLOOK_TENANT=consumers

# ---------------------------------------------------------------------------
# 8. MCP 远程模式（可选；默认 stdio，只有本地客户端能用）
#
#    MCP_TRANSPORT=http 后以 Streamable HTTP 暴露在 /mcp 端点，
#    供远程 MCP 客户端接入。绑定非回环地址前务必设置 MCP_TOKEN。
# ---------------------------------------------------------------------------

# MCP_TRANSPORT=http
# MCP_PORT=8410
# MCP_BIND=127.0.0.1
# MCP_TOKEN=
