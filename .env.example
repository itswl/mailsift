# ============================================================================
# mailsift configuration. All settings live in this file.
# Copy it to .env and edit it: cp .env.example .env
# ============================================================================

# ---------------------------------------------------------------------------
# 1. Mail accounts (required; add any number, starting at 1)
#
#    Format: MAIL_ACCOUNT_N=provider|email|password[|custom-host]
#    The password is usually an app password or provider authorization code.
# ---------------------------------------------------------------------------

MAIL_ACCOUNT_1=qq|me@qq.com|app-password
MAIL_ACCOUNT_1_NAME=personal-qq
MAIL_ACCOUNT_1_FOLDERS=all

# Add another account from the same provider by incrementing the number.
# MAIL_ACCOUNT_2=qq|work@qq.com|another-app-password
# MAIL_ACCOUNT_2_NAME=work-qq

# For a provider not in the presets, use imap and specify its host.
# MAIL_ACCOUNT_3=imap|me@mycorp.com|password|imap.mycorp.com

# Gmail and Outlook generally require OAuth. Run npm run oauth once;
# no password is needed on these account lines afterward.
# MAIL_ACCOUNT_4=gmail|me@gmail.com
# MAIL_ACCOUNT_5=outlook|me@outlook.com

# Providers:
#   qq / qq_biz / 163 / 126 / sina / aliyun / feishu / lark
#   gmail / gmail_pw / outlook / icloud / fastmail / yahoo / zoho / yandex / gmx
#   imap (specify a host; any IMAP provider can be used)
#
# Optional per-account settings (replace N with the account number):
#   MAIL_ACCOUNT_N_NAME     Display name in notifications; defaults to provider-user.
#   MAIL_ACCOUNT_N_FOLDERS  Folders to monitor; default: INBOX,spam.
#                           all  = all folders except sent, drafts, and trash (recommended).
#                           spam = automatically detect the provider's spam folder.
#   MAIL_ACCOUNT_N_PORT     Default: 993.
#   MAIL_ACCOUNT_N_SSL      Default: true.
#   MAIL_ACCOUNT_N_AUTH     Follows the provider preset by default.
#
# Only used by the web view (section 8), and only when it may act on mail:
#   MAIL_ACCOUNT_N_FROM_NAME    The name replies are sent under; the bare address when unset.
#   MAIL_ACCOUNT_N_SMTP_HOST    Submission server. The presets already know theirs; a mailbox
#                               on a custom host cannot send until this is set.
#   MAIL_ACCOUNT_N_SMTP_PORT    Default: the preset's, else 465. 465 is TLS from the first
#                               byte, any other port must offer STARTTLS. Never unencrypted.
#   MAIL_ACCOUNT_N_AUTHSERV_ID  What this mailbox's receiving server calls itself in
#                               Authentication-Results (for example mx.example.com), so the
#                               reader can show whether a sender was verified. Known for
#                               Gmail, Outlook, Yahoo, iCloud, Fastmail and QQ; for anyone else
#                               no verdict is shown until this is set. `none` switches it off.

# ---------------------------------------------------------------------------
# 2. Notification outputs (configure at least one; both can be enabled)
# ---------------------------------------------------------------------------

# Feishu / Lark custom bot
FEISHU_WEBHOOK_URL=
# Required only when signature verification is enabled on the bot.
FEISHU_WEBHOOK_SECRET=

# Webhook output. WEBHOOK_URL is the complete endpoint to post to; the payload
# groups its fields under mail, triage and signal so a receiver can recognise
# this shape rather than treat it as anonymous JSON. See docs/signal-event-v1.md.
WEBHOOK_URL=
# Sent as a `token` header when set. An authenticated endpoint will reject
# requests without it.
WEBHOOK_TOKEN=
#
# Superseded: WEBHOOKWISE_URL took a base that /api/v1/webhook/<WEBHOOKWISE_SOURCE>
# was appended to. Those names still work and still behave that way, so an
# existing deployment keeps running, but WEBHOOK_URL is the one to use.

# ---------------------------------------------------------------------------
# 3. LLM (optional; without it, local keyword fallback is used)
#
#    mailsift sends OpenAI-compatible POST requests to /chat/completions.
#    The response must contain choices[0].message.content with JSON in this form:
#    {"results":[{"index":0,"importance":"info|warning|critical",...
#    }]} (see src/services/triage.ts for the complete contract).
# ---------------------------------------------------------------------------

# Option 1: use a provider preset.
#   Options: dashscope / deepseek / glm / minimax / moonshot / openai /
#        openrouter / siliconflow / xai / zhipu
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
LLM_API_KEY=

# Option 2: use a custom or self-hosted OpenAI-compatible endpoint.
# Leave LLM_PROVIDER empty when LLM_BASE_URL is set.
# LLM_PROVIDER=
# LLM_BASE_URL=https://your-gateway.example.com/v1
# LLM_MODEL=gpt-5.6-luna

# Messages per LLM batch. Larger batches cost less but increase failure impact.
LLM_BATCH_SIZE=10
# Number of body characters sent per email. Larger values cost more.
LLM_BODY_CHARS=1200
# Prior processed messages from the same account thread included as context (0-5).
LLM_THREAD_CONTEXT_MESSAGES=3
LLM_TIMEOUT_SECONDS=60
# Set false if the provider does not support response_format=json_object.
# mailsift retries without response_format when the provider explicitly rejects it.
LLM_JSON_MODE=true
# Language of summaries and reasons: en (default), zh-CN, zh-TW, auto (follow
# each message's language), or any language name.
#
# Categories are deliberately NOT translated. They come from a fixed vocabulary
# (Security, Finance, Delivery, Travel, Health, Legal, Work, Personal, Social,
# Marketing, System, Other) because the daily digest groups by category and MCP
# callers search on it. Anything else the model returns is folded into Other.
LLM_OUTPUT_LANGUAGE=en
# Verification codes, sign-in links, and mails carrying credentials (private
# keys, JWTs, provider tokens) stay on the local classifier by default.
LLM_SKIP_SENSITIVE=true
# Mail with a private key, a provider-prefixed token, or a JWT presented as a
# credential (not a token inside a link) is hidden and judged locally. Set false
# to triage it like any other mail; those values are still redacted either way.
SENSITIVE_SECRET_MAIL=true
# Redact direct identifiers before sending fields to the LLM: email addresses,
# phone numbers, payment card and bank account numbers (IBAN), resident IDs,
# US SSNs, license plates, and common API keys/tokens. Numeric identifiers are
# only redacted when their checksum holds, so order, waybill, and invoice numbers
# stay readable. Local notifications retain the original values.
LLM_REDACT_PII=true
# Count direct identifiers the model repeats in its summary or reason. The text
# is kept and only a warning with types/counts is logged, so a leaky summary is
# visible without silently rewriting what the reader sees. Off by default.
LLM_SCAN_OUTPUT=false
# Alert after this many consecutive LLM failures; triage continues with fallback.
LLM_ALERT_AFTER_FAILURES=2

# Two-stage triage (optional). With these set, a calibrated decision model
# (Cloudflare Clef on Workers AI) answers typed questions to decide importance,
# category, and action_required first — no text to hallucinate, every answer
# carries a confidence — and the LLM above only writes the summary/reason/
# deadline it is good at. Leave DECIDER_API_TOKEN empty (the default) to keep
# the original single-LLM pipeline.
# DECIDER_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/run/@cf/cloudflare
# DECIDER_MODEL=clef-flash
# DECIDER_API_TOKEN=
# Per-request timeout for the decision stage.
# DECIDER_TIMEOUT_SECONDS=15
# Route both triage stages through a Cloudflare AI Gateway (analytics, logs,
# rate limiting) by naming it here. The header is meaningless for non-Cloudflare
# endpoints, so leave it unset when LLM_BASE_URL or DECIDER_BASE_URL point
# elsewhere (e.g. back at DeepSeek).
# AI_GATEWAY_ID=default

# If the request fails, the response is invalid, or its indices are duplicated or
# out of range, the whole batch uses the local keyword fallback (a misaligned
# index list cannot be trusted for any message). A message merely omitted from an
# otherwise valid response falls back on its own. Keyword hits remain
# warning-level alerts; other messages become info and are queued for
# digest/review. Recovery does not automatically re-triage messages that were
# already processed during fallback.

# ---------------------------------------------------------------------------
# 4. Classification and notification rules
# ---------------------------------------------------------------------------

# Most important: tell the model who you are and what matters to you.
# Specific context produces better triage results.
#
# Keep this on one line. Unquoted newlines in .env truncate the value.
MAIL_CONTEXT=I am a software engineer. Do not push routine low-value bank alerts; push unusual transactions, security events, deadlines, interviews, contracts, and messages that explicitly ask me to act.

# Sender rules (comma-separated). Three forms:
#   @bank.com          the address domain or any subdomain (not the display name)
#   alerts@bank.com    exactly that address
#   newsletter         a substring of the address or display name
# Matches are marked critical without consulting the LLM.
MAIL_ALWAYS_IMPORTANT=
# Same forms; matches are marked info without consulting the LLM.
MAIL_NEVER_IMPORTANT=
# Fallback keywords used when the LLM is unavailable (comma-separated).
MAIL_KEYWORDS=verification code,bill,past due,frozen,unusual login,contract,interview,invoice

# When several mailboxes are monitored and one forwards into another, the copy
# is a new message with its own Message-ID, so deduplication cannot see it.
# Matching the sender against the configured accounts can. A copy is recorded
# and stays searchable, but it is neither notified nor repeated in the daily
# digest, because the original was already triaged at its source. It costs no
# LLM call either. Mail you send to yourself inside one mailbox is unaffected,
# and an explicit MAIL_ALWAYS_IMPORTANT sender still wins.
SUPPRESS_SELF_FORWARDS=true

# Minimum importance for real-time push: info / warning / critical.
# Use critical to reduce notifications; lower levels remain in the digest.
PUSH_MIN_IMPORTANCE=warning

# Importance bonus for spam-folder mail (0-2). Usually leave this at 0.
#
# The bonus lifts spam by whole importance levels, and info is the lowest one,
# so with the default PUSH_MIN_IMPORTANCE=warning a bonus of 1 pushes EVERY
# spam-folder message: warning and critical were already above the line, and
# info is now on it. That is rarely what people expect from this setting.
#
# You do not need it to catch a message wrongly filed as spam. Triage assesses
# spam-folder mail normally, so a real bill, code, or human message is rated
# warning or critical there and is delivered with the bonus at 0. Spam also
# always reaches the daily digest regardless of its level.
#
# It is worth setting when PUSH_MIN_IMPORTANCE is critical and you still want
# spam-folder warnings to break through. --check warns about the combinations
# that deliver the whole spam folder.
SPAM_RANK_BONUS=0

# ---------------------------------------------------------------------------
# 5. Daily digest: collect messages below the push threshold.
# ---------------------------------------------------------------------------

DIGEST_ENABLED=true
# A whole hour from 0 to 23 on the server's clock: set TZ (docker-compose.yml defaults it
# to Asia/Shanghai). Any other value falls back to 9; --check reports it.
DIGEST_HOUR=9
DIGEST_MIN_IMPORTANCE=info

# ---------------------------------------------------------------------------
# 6. Runtime settings (usually no changes needed)
# ---------------------------------------------------------------------------

# Poll interval in seconds.
POLL_INTERVAL_SECONDS=300
# Lookback window for the first scan.
INITIAL_LOOKBACK_DAYS=3
# Bound each fresh-lookback backfill chunk without skipping the remaining backlog.
MAX_MESSAGES_PER_LOOKBACK=500
# Per-folder message limit per poll.
MAX_MESSAGES_PER_POLL=200
# Maximum source/text-body size to parse. Larger messages are read by text body
# part only, so large attachment bytes are not included in the MIME parser.
MAX_MESSAGE_SOURCE_BYTES=5242880
# Total message limit across all accounts and folders per poll.
MAX_MESSAGES_PER_POLL_TOTAL=500
# Maximum concurrent account connections.
MAX_CONCURRENT_ACCOUNTS=5
# Immediate retries (2s, then 5s apart) for a notification push that fails with a
# network error, a timeout, or HTTP 408/429/5xx, before the outbox retries it on
# the next poll. Other rejections are not retried. Set 1 to disable.
SINK_RETRY_ATTEMPTS=3
# Persistent notification outbox retry backoff after immediate retries.
# The first failed outbox attempt waits 60s, then doubles up to 1h by default.
OUTBOX_RETRY_BASE_SECONDS=60
OUTBOX_RETRY_MAX_SECONDS=3600

# Real-time wake-ups over IMAP IDLE (RFC 2177). One read-only connection per
# account and folder stays open; a new-mail notification fetches that folder at
# once on the same connection. Polling keeps running as the reconciliation pass,
# so raise POLL_INTERVAL_SECONDS to 900-1800 when this is on. Accounts whose
# server does not advertise IDLE (see npm run probe) stay on polling. Folders
# listed here must also be monitored; "all" is not accepted.
IMAP_IDLE_ENABLED=false
IMAP_IDLE_FOLDERS=INBOX

STATE_DB_PATH=data/mailsift.db
STATE_RETENTION_DAYS=90
TOKEN_STORE_PATH=data/tokens.json

LOG_LEVEL=info
# Set true to log notifications without sending them.
DRY_RUN=false

# Optional OpenTelemetry metrics. Leave OTEL_METRICS_EXPORTER unset for local no-op mode.
# Set OTEL_EXPORTER_OTLP_ENDPOINT to the Collector base URL, for example http://otel-collector:4318.
# Do not put mailbox addresses, Message-IDs, or subjects in metric attributes.
# OTEL_METRICS_EXPORTER=otlp_proto
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_METRIC_EXPORT_INTERVAL_MS=60000

# Keep verification codes and one-time passwords out of the LLM entirely.
LLM_SKIP_SENSITIVE=true
# Redact direct identifiers in fields sent to the LLM; local notifications keep original content.
LLM_REDACT_PII=true
# Count identifiers the model repeats back; logs types/counts only, never values.
LLM_SCAN_OUTPUT=false

# Alert after consecutive failures to avoid noise from transient network/OAuth errors.
# This applies to authentication failures too: a single Outlook IMAP "Login failed"
# can be a temporary OAuth/token hiccup and should not create an alert/recovery pair.
ACCOUNT_ALERT_AFTER_FAILURES=2
ACCOUNT_ALERT_COOLDOWN_SECONDS=21600
# Also counts polls in which the decision stage (DECIDER_*) failed, which otherwise falls back quietly.
LLM_ALERT_AFTER_FAILURES=2

# Optional outbound heartbeat. After every completed poll mailsift sends a GET to this
# URL (Uptime Kuma push monitor, healthchecks.io, Better Stack heartbeat, ...), so a
# monitor outside this host notices when polling stops, which mailsift cannot report
# itself. Only http(s) URLs without a user name or password are used; the request
# carries no mail data, and only the monitor's host is ever logged.
# HEARTBEAT_PING_URL=

# ---------------------------------------------------------------------------
# 7. OAuth (only needed for Gmail / Outlook)
#
#    Register an application in Google Cloud Console / Azure to obtain credentials.
#    Use credentials from a trusted source only.
# ---------------------------------------------------------------------------

# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# OUTLOOK_CLIENT_ID=
# OUTLOOK_CLIENT_SECRET=
# OUTLOOK_TENANT=consumers

# ---------------------------------------------------------------------------
# 8. Embedded remote MCP mode (enabled by default)
#
#    With MCP_ENABLED=true, Streamable HTTP is exposed at /mcp in the main process.
#    MCP_BIND is the address inside the container/process. MCP_PUBLIC_HOST is the
#    Docker host address; the Compose mapping uses MCP_PORT on both sides.
#    Keep MCP_PUBLIC_HOST on 127.0.0.1 unless a reverse proxy or tunnel needs it.
#    A non-loopback MCP_BIND requires MCP_TOKEN. Without a token, loopback is
#    intentionally unauthenticated because it is not exposed beyond the host,
#    and the server then answers only to requests addressed to localhost,
#    127.0.0.1 or [::1], which is what keeps a web page elsewhere from reaching
#    it through a host name of its own. A proxy on the same machine that
#    forwards another name is listed in MCP_ALLOWED_HOSTS (comma-separated);
#    setting MCP_TOKEN is the better answer.
#
#    The surface is read-only by default. Write tools are not registered unless
#    MCP_WRITE_TOKEN is set: manage_mail (mark, star, archive, bin, move),
#    mark_handled, send_mail, record_feedback and retry_dead_letter. A caller
#    holding it is given what the web view's owner has, sending and binning
#    included, so give it only to a client you would hand your mailbox to.
#    Every mailbox action is resolved by Message-ID inside a writable IMAP lock
#    and recorded in the audit log. Set MCP_WRITE_TOKEN to a second, different
#    secret and present it as the bearer token to get the write tools; MCP_TOKEN
#    then stays a read-only credential that can be shared more freely.
#    Reusing one value for both is refused at startup. Over stdio the caller can
#    already read this file, so setting MCP_WRITE_TOKEN alone enables them there.
# ---------------------------------------------------------------------------

# MCP_ENABLED=true
# MCP_PUBLIC_HOST=127.0.0.1  Host-side Docker publish address; not used by npm run dev.
# MCP_BIND=0.0.0.0          Container/process listen address for Docker forwarding.
# MCP_PORT=8410              Host and container port in docker-compose.yml.
# MCP_TOKEN=
# MCP_WRITE_TOKEN=                Unset means strictly read-only. Must differ from MCP_TOKEN.
# MCP_ALLOWED_HOSTS=              Extra Host names accepted while MCP_TOKEN is unset.
# MCP_RATE_LIMIT_PER_MINUTE=120
# MCP_LIVE_BODY_CHARS=20000       Max normalized body characters returned by live IMAP.
# MCP_LIVE_SOURCE_BYTES=5242880   Max raw message bytes inspected by live IMAP.
# MCP_ATTACHMENT_MAX_BYTES=10485760 Max decoded bytes returned for one attachment.
# MCP_ATTACHMENT_SCAN_BYTES=1048576  Prefix decoded for local attachment heuristics (max 4 MiB).
# MCP_SAFETY_BODY_BYTES=262144       Text prefix parsed for link risk hints (max 1 MiB).
# MCP_LIVE_LOOKBACK_DAYS=90       Bounded fallback search window by Message-ID.
# MCP_LIVE_SEARCH_MAX_MESSAGES=500 Maximum candidates in that fallback search.
# MCP_TRANSPORT=stdio             Set to http only when running src/mcp.ts standalone.

# The web view: mailsift's own mail client, on the same port and behind the
# same tokens, at http://<host>:<MCP_PORT>/. It opens on what needs you, shows
# each message as it was sent (in a sandboxed frame, remote images held), and
# can search, answer questions about your mail and notify your devices.
#
# What it may change follows the token a browser signs in with. With MCP_TOKEN
# it reads. With MCP_WRITE_TOKEN it can also archive, bin, star, mark read,
# reply and send, and correct a judgement. Leave MCP_WRITE_TOKEN unset and the
# page never touches a mailbox. See docs/web-view.md.
#
# Off by default: a page a browser can reach is a wider surface than a JSON-RPC
# endpoint. Keep MCP_BIND on loopback, or put a reverse proxy with TLS in front;
# notifications and the installed app need HTTPS.
# WEB_UI_ENABLED=false

# Sending from the web view goes through each provider's own SMTP server with
# the mailbox's own credential, always encrypted. false switches it off for
# every mailbox (DRY_RUN=true does too).
# SMTP_ENABLED=true

# Web Push notifications to browsers that turned them on in the web view.
# Encrypted end to end; the signing key is generated on first use and kept in
# the state database.
# WEB_PUSH_ENABLED=true
# Contact the push services are given, as mailto:you@example.com or an https
# URL. Defaults to the address the page is served from. Apple refuses
# placeholders, so set it if notifications never reach an iPhone.
# WEB_PUSH_SUBJECT=
# A subscription is accepted only on the push services browsers use (Google,
# Mozilla, Apple, Microsoft). Comma-separated host suffixes to accept as well.
# WEB_PUSH_ALLOWED_HOSTS=

# Model calls the web view may make in a day (questions and reply drafts),
# across every session. 0 switches the assistant's calls off.
# WEB_ASSISTANT_DAILY_LIMIT=300

# Set when a reverse proxy sits in front, so the rate limit and the audit log
# key on the real caller rather than on the proxy. Without it every request
# behind a proxy shares one address, the per-client budget becomes a single
# shared one, and one noisy caller locks everybody else out. Leave it off when
# the port is reached directly: anyone can send these headers.
# TRUSTED_PROXY=false

# OAuth callback listener port; register http://localhost:<port>/ with the provider.
# OAUTH_REDIRECT_PORT=8765
# Optional minimum level for Feishu output: info / warning / critical.
# FEISHU_MIN_IMPORTANCE=warning

# Docker image version. Unset runs latest, which the next `docker compose pull`
# moves to whatever was released last. Pin a release (the Releases page lists
# them; drop the leading v) to upgrade only when you choose.
# MAILSIFT_VERSION=0.1.99
